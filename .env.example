# Required: a GitHub token permitted to read public issues and repository contents.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# Choose openai or webhook. The daemon never installs or runs an LLM locally.
LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_URL=https://api.openai.com/v1/responses
# For LLM_MODE=webhook, set your HTTP loopback or HTTPS URL.
LLM_WEBHOOK_URL=
LLM_WEBHOOK_TOKEN=

# Set Discord, Telegram, or both. Unused channels stay empty.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

STATE_DIR=./data
MIN_BOUNTY_USD=100
MIN_SCORE=1
TRUSTED_BOUNTY_BOTS=algora[bot],opire[bot],expensifybot
REPOMIX_VERSION=1.19.0
POLL_INTERVAL_MS=300000
RUN_BUDGET_MS=240000
REQUEST_TIMEOUT_MS=60000
SEARCH_INTERVAL_MS=2200
MAX_PAYLOAD_BYTES=800000
MAX_RESPONSE_BYTES=64000000
RETENTION_DAYS=90
